# BiocManager::install("DeSeq2")
library(tidyverse)
library(phyloseq)
library(DESeq2)
library(Biostrings)
load("ryan_filt.RData")
## NOTE: If you get a zeros error, then you need to add '1' count to all reads
# Convert taxonomy table to matrix
tax_mat <- as(tax_table(ryan_filt), "matrix")
tax_mat["f9283780d796ffcc12a283e56b806087", "Genus"] <- "g__Ruminococcus"
View(tax_mat)
write_csv(tax_mat, file = "taxmat")
write_csv(tax_mat, file = "taxmat", row.names = FALSE)
write_csv(tax_mat, file = "taxmat", row.names(FALSE))
write_csv(tax_mat, file = "taxmat", row.names(FALSE))
write_csv(tax_mat, file = "taxmat")
write.csv(tax_mat,"taxmat")
write_csv(as.data.frame(tax_mat), "taxmat.csv")
